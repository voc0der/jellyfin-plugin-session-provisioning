<Project>
    <!--
        Keep in step with "version:" in build.yaml. Jellyfin reads the manifest version
        from build.yaml when packaging, but reports the *assembly* version in the
        dashboard and in PluginManager's records; leaving this at the template's
        0.0.0.0 makes an installed plugin show as 0.0.0.0 while its manifest claims
        something else, and PluginManager's CreatePluginInstance rewrites manifests to
        reconcile the two. scripts/smoke-test.sh asserts the two stay equal.
    -->
    <PropertyGroup>
        <Version>1.0.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
    </PropertyGroup>
</Project>
