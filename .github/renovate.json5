{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended', 'group:allNonMajor'],
  // Jellyfin.Controller and Jellyfin.Model take their version from JellyfinPackageVersion
  // in Directory.Build.props, and Renovate's NuGet manager skips a version given by a
  // property, so the property itself is tracked. It is read as semver, since NuGet treats
  // a bare version as a minimum and would count 12.1.0 as already satisfying 12.0.0. The
  // smoke test's default server image moves with it, since the suite runs against the
  // version the plugin is built for.
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: ['/^Directory\\.Build\\.props$/', '/^scripts/smoke-test\\.sh$/'],
      matchStrings: [
        '<JellyfinPackageVersion>(?<currentValue>[^<]+)</JellyfinPackageVersion>',
        'JELLYFIN_VERSION="\\$\\{JELLYFIN_VERSION:-(?<currentValue>[^}]+)\\}"',
      ],
      depNameTemplate: 'Jellyfin.Controller',
      datasourceTemplate: 'nuget',
      versioningTemplate: 'semver',
    },
  ],
  // main has no branch protection, so GitHub's auto-merge is unavailable. Renovate merges
  // on its own next run, and only once every check on the PR has passed.
  platformAutomerge: false,
  // Majors wait on the Dependency Dashboard issue until approved there.
  major: {
    dependencyDashboardApproval: true,
  },
  packageRules: [
    {
      // Nobody reviews these before they merge, so a compromised publish gets a few days
      // to be caught and pulled first. Security fixes still come from Dependabot, which
      // does not wait.
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest'],
      automerge: true,
      minimumReleaseAge: '3 days',
    },
    {
      // The Jellyfin packages must match each other, so they share one PR, and it never
      // merges unattended. A bump here is never routine: JellyfinPackageVersion in
      // Directory.Build.props is the server this plugin is built and tested against, and
      // the smoke suite runs against that exact container image. Treat the PR as "a new
      // server version is available" and re-run scripts/smoke-test.sh against it, not as a
      // dependency update.
      matchPackageNames: ['Jellyfin.*'],
      groupName: 'Jellyfin packages',
      automerge: false,
    },
  ],
}
